{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/data/:path*", "destination": "/api/data" },
    { "source": "/feeds/spot/:path*", "destination": "/api/data?kind=feed" },
    { "source": "/logos/:path*", "destination": "/api/data?kind=logo" },
    { "source": "/:path*", "destination": "/api/page" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
