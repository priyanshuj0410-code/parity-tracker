rules_version = '2';

// Nothing is public. The site reads releases from the static data site (decision 0016), and the data tools read
// and write as the nivel-pipeline service account, through IAM, which these rules do not govern (PARITY-101).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
